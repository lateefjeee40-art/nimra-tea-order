<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SN FOODS Order</title>
    <style>
        body { background-color: #fbcce7; font-family: sans-serif; text-align: center; padding: 10px; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; max-width: 500px; margin: auto; }
        .card { background: white; padding: 10px; border-radius: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        img { width: 100%; height: 120px; object-fit: contain; }
        input { width: 80%; padding: 8px; margin-top: 5px; border: 1px solid #ccc; border-radius: 5px; }
        button { width: 100%; padding: 15px; margin-top: 20px; background: #25d366; color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: bold; cursor: pointer; }
    </style>
</head>
<body>

    <h2>SN FOODS آرڈر فارم</h2>

    <div class="grid">
        <div class="card"><img src="https://i.postimg.cc/qvFdC0H1/p1.jpg"><p>20 Gram (ڈبی)</p><input type="number" id="p1" placeholder="تعداد"></div>
        <div class="card"><img src="https://i.postimg.cc/NjHdpwrr/p2.jpg"><p>40 Gram (ڈبی)</p></div>
        <div class="card"><img src="https://i.postimg.cc/LsS3DgSK/p3.jpg"><p>75 Gram (ڈبی)</p><input type="number" id="p3" placeholder="تعداد"></div>
        <div class="card"><img src="https://i.postimg.cc/QdGQNKH0/4.jpg"><p>150 Gram (جار)</p><input type="number" id="p4" placeholder="تعداد"></div>
        <div class="card"><img src="https://i.postimg.cc/Z0kdqXKz/5.jpg"><p>Special (پاؤچ)</p><input type="number" id="p5" placeholder="تعداد"></div>
    </div>

    <button onclick="sendOrder()">واٹس ایپ پر آرڈر بھیجیں</button>

    <script>
        function sendOrder() {
            let msg = "السلام علیکم، میرا آرڈر:%0A";
            msg += "20g: " + (document.getElementById('p1').value || 0) + "%0A";
            msg += "75g: " + (document.getElementById('p3').value || 0) + "%0A";
            msg += "150g: " + (document.getElementById('p4').value || 0) + "%0A";
            msg += "Special: " + (document.getElementById('p5').value || 0);
            window.open("https://wa.me/923009695663?text=" + msg);
        }
    </script>
</body>
</html>
